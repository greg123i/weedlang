import "lib/core.weed";

fn emit_span(i8* kind, i8* start, i8* finish, i64 line) {
    print_int(line);
    print(":");
    print_int(1);
    print(" ");
    print(kind);
    print(" ");
    print_int(finish - start);
    print(":");
    while (start != finish) {
        print_char(*start);
        start = start + 1;
    }
    print("\n");
}

fn bump_pos(i8 c, i64* line) {
    if (c == 10) {
        *line = *line + 1;
    }
}

fn is_keyword(i8* start, i8* finish) -> i64 {
    if (
        (finish - start == 2 && *start == 102 && *(start + 1) == 110) ||
        (finish - start == 6 && *start == 114 && *(start + 1) == 101 && *(start + 2) == 116 && *(start + 3) == 117 && *(start + 4) == 114 && *(start + 5) == 110) ||
        (finish - start == 2 && *start == 105 && *(start + 1) == 102) ||
        (finish - start == 4 && *start == 101 && *(start + 1) == 108 && *(start + 2) == 115 && *(start + 3) == 101) ||
        (finish - start == 5 && *start == 119 && *(start + 1) == 104 && *(start + 2) == 105 && *(start + 3) == 108 && *(start + 4) == 101) ||
        (finish - start == 6 && *start == 115 && *(start + 1) == 116 && *(start + 2) == 114 && *(start + 3) == 117 && *(start + 4) == 99 && *(start + 5) == 116) ||
        (finish - start == 5 && *start == 99 && *(start + 1) == 111 && *(start + 2) == 110 && *(start + 3) == 115 && *(start + 4) == 116) ||
        (finish - start == 6 && *start == 105 && *(start + 1) == 109 && *(start + 2) == 112 && *(start + 3) == 111 && *(start + 4) == 114 && *(start + 5) == 116) ||
        (finish - start == 7 && *start == 102 && *(start + 1) == 111 && *(start + 2) == 114 && *(start + 3) == 101 && *(start + 4) == 105 && *(start + 5) == 103 && *(start + 6) == 110) ||
        (finish - start == 9 && *start == 99 && *(start + 1) == 111 && *(start + 2) == 109 && *(start + 3) == 112 && *(start + 4) == 116 && *(start + 5) == 105 && *(start + 6) == 109 && *(start + 7) == 101 && *(start + 8) == 109) ||
        (finish - start == 3 && *start == 97 && *(start + 1) == 115 && *(start + 2) == 109) ||
        (finish - start == 2 && *start == 97 && *(start + 1) == 115) ||
        (finish - start == 12 && *start == 109 && *(start + 1) == 97 && *(start + 2) == 99 && *(start + 3) == 114 && *(start + 4) == 111 && *(start + 5) == 95 && *(start + 6) == 114 && *(start + 7) == 117 && *(start + 8) == 108 && *(start + 9) == 101 && *(start + 10) == 115) ||
        (finish - start == 4 && *start == 99 && *(start + 1) == 104 && *(start + 2) == 97 && *(start + 3) == 114) ||
        (finish - start == 5 && *start == 115 && *(start + 1) == 104 && *(start + 2) == 111 && *(start + 3) == 114 && *(start + 4) == 116) ||
        (finish - start == 3 && *start == 105 && *(start + 1) == 110 && *(start + 2) == 116) ||
        (finish - start == 4 && *start == 108 && *(start + 1) == 111 && *(start + 2) == 110 && *(start + 3) == 103) ||
        (finish - start == 2 && *start == 105 && *(start + 1) == 56) ||
        (finish - start == 3 && *start == 105 && *(start + 1) == 49 && *(start + 2) == 54) ||
        (finish - start == 3 && *start == 105 && *(start + 1) == 51 && *(start + 2) == 50) ||
        (finish - start == 3 && *start == 105 && *(start + 1) == 54 && *(start + 2) == 52) ||
        (finish - start == 2 && *start == 117 && *(start + 1) == 56) ||
        (finish - start == 3 && *start == 117 && *(start + 1) == 49 && *(start + 2) == 54) ||
        (finish - start == 3 && *start == 117 && *(start + 1) == 51 && *(start + 2) == 50) ||
        (finish - start == 3 && *start == 117 && *(start + 1) == 54 && *(start + 2) == 52) ||
        (finish - start == 4 && *start == 118 && *(start + 1) == 111 && *(start + 2) == 105 && *(start + 3) == 100)
    ) {
        1
    } else {
        0
    }
}

fn skip_trivia(i8* p, i64* line) -> i8* {
    i8* prev = 0;
    while (p != prev) {
        prev = p;
        p = skip_spaces(p, line);
        p = skip_comment(p, line);
    }
    p
}

fn skip_spaces(i8* p, i64* line) -> i8* {
    while (is_space(*p) != 0) {
        bump_pos(*p, line);
        p = p + 1;
    }
    p
}

fn skip_comment(i8* p, i64* line) -> i8* {
    if (*p == 47 && *(p + 1) == 47) {
        while (*p != 0 && *p != 10) {
            bump_pos(*p, line);
            p = p + 1;
        }
    }
    p
}

fn scan_word(i8* p, i64* line) -> i8* {
    i8* start = p;
    while (is_alnum(*p) != 0 || *p == 95) {
        p = p + 1;
    }
    if (is_keyword(start, p) != 0) {
        emit_span("KEYWORD", start, p, *line);
    } else {
        emit_span("IDENT", start, p, *line);
    }
    p
}

fn scan_number(i8* p, i64* line) -> i8* {
    i8* start = p;
    while (is_digit(*p) != 0) {
        p = p + 1;
    }
    emit_span("NUMBER", start, p, *line);
    p
}

fn scan_string(i8* p, i64* line) -> i8* {
    i8* start = p + 1;
    p = p + 1;
    while (*p != 0 && *p != 34) {
        if (*p == 92 && *(p + 1) != 0) {
            p = p + 1;
        }
        p = p + 1;
    }
    if (*p == 34) {
        p = p + 1;
    }
    emit_span("STRING", start, p - 1, *line);
    p
}

fn maybe_two(i8 c, i8 next, i64* adv, i8* out, i8 a, i8 b) {
    if (c == a && next == b) {
        *adv = 2;
        out[1] = b;
    }
}

fn scan_punc(i8* p, i64* line) -> i8* {
    i8 c = *p;
    i8 next = *(p + 1);
    i8[4] out;
    i8* dst = out;
    i64 adv = 1;

    out[0] = c;
    out[1] = 0;
    out[2] = 0;
    out[3] = 0;

    maybe_two(c, next, &adv, dst, 45, 62);
    maybe_two(c, next, &adv, dst, 61, 61);
    maybe_two(c, next, &adv, dst, 33, 61);
    maybe_two(c, next, &adv, dst, 60, 61);
    maybe_two(c, next, &adv, dst, 62, 61);
    maybe_two(c, next, &adv, dst, 38, 38);
    maybe_two(c, next, &adv, dst, 124, 124);
    maybe_two(c, next, &adv, dst, 61, 62);

    emit_span("PUNC", dst, dst + adv, *line);
    p + adv
}

fn scan_nonword(i8* p, i64* line) -> i8* {
    if (is_digit(*p) != 0) {
        scan_number(p, line)
    } else if (*p == 34) {
        scan_string(p, line)
    } else {
        scan_punc(p, line)
    }
}

fn scan_token(i8* p, i64* line) -> i8* {
    if (*p == 0) {
        p
    } else if (is_alpha(*p) != 0 || *p == 95) {
        scan_word(p, line)
    } else {
        scan_nonword(p, line)
    }
}

fn tokenize(i8* src) {
    i8* p = src;
    i64 line = 1;

    while (*p != 0) {
        p = skip_trivia(p, &line);
        p = scan_token(p, &line);
    }
    emit_span("EOF", src, src, line);
}

fn main() -> int {
    i8* path = first_command_arg();
    if (path == 0) {
        i8* buf = malloc(65536) as i8*;
        u32 n = read_stdin(buf as void*, 65535);
        buf[n] = 0;
        tokenize(buf);
        free(buf as void*);
    } else {
        i8* src = read_file_text(path);
        if (src == 0) {
            print("could not read file: ");
            println(path);
            return 1;
        }
        tokenize(src);
    }
    0
}
