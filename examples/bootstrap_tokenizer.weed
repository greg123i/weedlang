import "lib/core.weed";

fn emit(i8* kind, i8* val, i64 line, i64 col) {
    print_int(line);
    print(":");
    print_int(col);
    print(" ");
    print(kind);
    print(" ");
    print(val);
    print("\n");
}

fn is_keyword(i8* s) -> i64 {
    if (streq(s, "fn") != 0) { return 1; }
    if (streq(s, "return") != 0) { return 1; }
    if (streq(s, "if") != 0) { return 1; }
    if (streq(s, "else") != 0) { return 1; }
    if (streq(s, "while") != 0) { return 1; }
    if (streq(s, "struct") != 0) { return 1; }
    if (streq(s, "const") != 0) { return 1; }
    if (streq(s, "import") != 0) { return 1; }
    if (streq(s, "foreign") != 0) { return 1; }
    if (streq(s, "comptime") != 0) { return 1; }
    if (streq(s, "asm") != 0) { return 1; }
    if (streq(s, "as") != 0) { return 1; }
    if (streq(s, "macro_rules") != 0) { return 1; }
    if (streq(s, "char") != 0) { return 1; }
    if (streq(s, "short") != 0) { return 1; }
    if (streq(s, "int") != 0) { return 1; }
    if (streq(s, "long") != 0) { return 1; }
    if (streq(s, "i8") != 0) { return 1; }
    if (streq(s, "i16") != 0) { return 1; }
    if (streq(s, "i32") != 0) { return 1; }
    if (streq(s, "i64") != 0) { return 1; }
    if (streq(s, "u8") != 0) { return 1; }
    if (streq(s, "u16") != 0) { return 1; }
    if (streq(s, "u32") != 0) { return 1; }
    if (streq(s, "u64") != 0) { return 1; }
    if (streq(s, "void") != 0) { return 1; }
    0
}

fn tokenize(i8* src) {
    i8* p = src;
    i8[1024] buf;
    i8* bp = buf;
    i8[4] punc_buf;
    i8* pbp = punc_buf;

    i64 cur_line = 1;
    i64 cur_col = 1;

    while (*p != 0) {
        if (is_space(*p) != 0) {
            if (*p == 10) {
                cur_line = cur_line + 1;
                cur_col = 1;
            } else {
                cur_col = cur_col + 1;
            }
            p = p + 1;
        } else {
            if (*p == 47 && *(p + 1) == 47) { // // comment
                while (*p != 0 && *p != 10) {
                    p = p + 1;
                }
            } else {
                i64 start_line = cur_line;
                i64 start_col = cur_col;

                if (is_alpha(*p) != 0 || *p == 95) {
                    i8* start = p;
                    while (is_alnum(*p) != 0 || *p == 95) {
                        p = p + 1;
                        cur_col = cur_col + 1;
                    }
                    i64 len = p - start;
                    if (len > 1023) { len = 1023; }
                    i64 i = 0;
                    while (i < len) {
                        bp[i] = *(start + i);
                        i = i + 1;
                    }
                    bp[len] = 0;
                    if (is_keyword(bp) != 0) { emit("KEYWORD", bp, start_line, start_col); } else { emit("IDENT", bp, start_line, start_col); }
                } else {
                    if (is_digit(*p) != 0) {
                        i8* start = p;
                        while (is_digit(*p) != 0) {
                            p = p + 1;
                            cur_col = cur_col + 1;
                        }
                        i64 len = p - start;
                        if (len > 1023) { len = 1023; }
                        i64 i = 0;
                        while (i < len) {
                            bp[i] = *(start + i);
                            i = i + 1;
                        }
                        bp[len] = 0;
                        emit("NUMBER", bp, start_line, start_col);
                    } else {
                        if (*p == 34) { // "
                            p = p + 1;
                            cur_col = cur_col + 1;
                            i8* start = p;
                            while (*p != 0 && *p != 34) {
                                if (*p == 92 && *(p + 1) != 0) { // \
                                    p = p + 1;
                                    cur_col = cur_col + 1;
                                }
                                if (*p == 10) {
                                    cur_line = cur_line + 1;
                                    cur_col = 1;
                                } else {
                                    cur_col = cur_col + 1;
                                }
                                p = p + 1;
                            }
                            i64 len = p - start;
                            if (len > 1023) { len = 1023; }
                            i64 i = 0;
                            while (i < len) {
                                bp[i] = *(start + i);
                                i = i + 1;
                            }
                            bp[len] = 0;
                            if (*p == 34) { 
                                p = p + 1;
                                cur_col = cur_col + 1;
                            }
                            emit("STRING", bp, start_line, start_col);
                        } else {
                            i8 c = *p;
                            p = p + 1;
                            cur_col = cur_col + 1;
                            pbp[0] = c;
                            pbp[1] = 0;
                            pbp[2] = 0;
                            pbp[3] = 0;

                            if (c == 45 && *p == 62) { // ->
                                pbp[1] = 62; p = p + 1; cur_col = cur_col + 1;
                            } else {
                                if (c == 61 && *p == 61) { // ==
                                    pbp[1] = 61; p = p + 1; cur_col = cur_col + 1;
                                } else {
                                    if (c == 33 && *p == 61) { // !=
                                        pbp[1] = 61; p = p + 1; cur_col = cur_col + 1;
                                    } else {
                                        if (c == 60 && *p == 61) { // <=
                                            pbp[1] = 61; p = p + 1; cur_col = cur_col + 1;
                                        } else {
                                            if (c == 62 && *p == 61) { // >=
                                                pbp[1] = 61; p = p + 1; cur_col = cur_col + 1;
                                            } else {
                                                if (c == 38 && *p == 38) { // &&
                                                    pbp[1] = 38; p = p + 1; cur_col = cur_col + 1;
                                                } else {
                                                    if (c == 124 && *p == 124) { // ||
                                                        pbp[1] = 124; p = p + 1; cur_col = cur_col + 1;
                                                    } else {
                                                        if (c == 61 && *p == 62) { // =>
                                                            pbp[1] = 62; p = p + 1; cur_col = cur_col + 1;
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            emit("PUNC", pbp, start_line, start_col);
                        }
                    }
                }
            }
        }
    }
    emit("EOF", "", cur_line, cur_col);
}

fn main() -> int {
    i8* path = first_command_arg();
    if (path == 0) {
        i8* buf = malloc(65536) as i8*;
        u32 n = read_stdin(buf as void*, 65535);
        buf[n] = 0;
        tokenize(buf);
        free(buf as void*);
    } else {
        i8* src = read_file_text(path);
        if (src == 0) {
            print("could not read file: ");
            println(path);
            return 1;
        }
        tokenize(src);
    }
    0
}
